  lea r8,[r8+rdx*8+20]
  movss xmm0,[r8]
  movss xmm1,[r8+4]
  mulss xmm0,[AMFE_Scale]
  mulss xmm1,[AMFE_Scale]
  addss xmm0,[AMFE_OffsetX]
  addss xmm1,[AMFE_OffsetY]
  cvtss2si eax,xmm0
  cvtss2si edx,xmm1
  shl rdx,20
  or rax,rdx
  // Physical cursor movement is intentionally external-only. Keeping a
  // second SetCursorPos here makes the visible cursor flicker to the panel origin.
  inc qword ptr [AMFE_FollowCount]
  ret
