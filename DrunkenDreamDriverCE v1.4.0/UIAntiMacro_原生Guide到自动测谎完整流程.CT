    <CheatEntry>
      <ID>42000</ID>
      <Description>[主脚本] 激活后安全空闲；再把“开始/重新运行”改为1</Description>
      <Options moHideChildren="1" />
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local pathFile=[[C:\Users\ceshi\Desktop\yhc-5.0\测谎\UIAntiMacro_Path.bin]]
local tries=0
local t=createTimer(nil,false)
t.Interval=100
t.OnTimer=function(timer)
  tries=tries+1
  local base=getAddressSafe('AMUnifiedFlow')
  local dst=base and (base+0x8000) or nil
  local loaded=base and (base+0x4078) or nil
  if dst and loaded then
    local f=io.open(pathFile,'rb')
    if f then
      local s=f:read('*a')
      f:close()
      if s and #s==0x14A0 then
        local pos=1
        while pos&lt;=#s do
          local last=math.min(pos+511,#s)
          local bytes={s:byte(pos,last)}
          writeBytes(dst+pos-1,bytes)
          pos=last+1
        end
        writeBytes(loaded,1)
      end
    end
    timer.destroy()
  elseif tries&gt;=100 then
    timer.destroy()
  end
end
t.Enabled=true
{$asm}
